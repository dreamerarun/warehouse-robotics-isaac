<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekIwi_ros2_control</name>
  <version>0.1.0</version>
  <description>
    ROS 2 Humble control stack for the LeKiwi mobile manipulator running in
    Isaac Sim 5.1: ros2_control configuration, controllers, keyboard
    teleoperation and the Isaac Sim OmniGraph action graph scripts.
  </description>
  <maintainer email="arun@example.com">arun</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- runtime -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>ros2controlcli</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- the ros2_control hardware interface that bridges to Isaac Sim -->
  <exec_depend>lekiwi_isaac_hardware</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
